#include <stdio.h>
#include<stdlib.h>
typedef struct node
{
    int data;
    struct node* next;
}Node;
 
Node *makeNode(int val)
{
    Node *newnode = (Node *)malloc(sizeof(Node));
    newnode->next = NULL;
    newnode->data = val;
    return newnode;
}
Node *inserthead(Node *t , int val)
{
   
    if(!t) return makeNode(val);
    Node *temp = makeNode(val);
     temp->next = t;
    t = temp ;
 
    return t;
}
Node *insertail(Node *t , int val)
{
    if(!t) return makeNode(val);
    Node *temp = t;
    while(temp->next)
    {
        temp = temp->next;
    }
    temp->next = makeNode(val);
    return  t;
}
int search(Node *t , int val)
{
    if(!t) return 0;
    if(t->data == val)
    return 1;
    return search( t->next , val);
}
 
int pos(Node *t ,int val, int posi)
{
    if(!t) return 0;
    if( t->data == val) return posi ;
    return pos(t->next,val,posi+1);
}
Node *insertatposi(Node *t , int data , int pos)
{
    if(!t) return t ;
    Node *temp = makeNode(data);
    if(pos == 1)
    {
        temp->next = t;
        return temp;
    }
    Node *l =t;
    for(int i=1 ; i<pos-1 && l!=NULL; i++)
    {
        l= l->next;
    }
     temp->next = l->next;
     l->next = temp ;
     return t;
}
int count(Node *t)
{
    if(!t) return 0;
    int count = 0 ;  
    while(t)
    {
        count++;
        t = t->next;
    }
    return count;
}
Node *insert(Node *t,int data)
{
    if(!t) return t;
     Node *temp = makeNode(data);
    if(t->data > data)
    {
        temp->next = t;
        return temp;
    }
    Node *t1 = t;
    while(t1->next && t1->next->data < data)
    {
        t1 = t1->next;
    }
    
         temp->next = t1->next;
         t1->next = temp ;
         
    return t;
}
void display(Node *n)
{
    while(n!=NULL)
    {
        printf("%5d",n->data);
        n= n->next;
    }
    printf("\n");
}
Node *deletepos(Node *t , int pos , int cp)//del by posi
{
    if(!t) return t;
    if(pos == cp )
     return t->next;
 
     t->next = deletepos(t->next,pos,cp+1);
     return t;
}
Node *delval(Node *t,int data)
{
    if(!t) return t;
    if(t->data == data)return t->next;
    Node* l = t;
    while(l->next) {
    if(l->next->data == data)
    {
        l->next = l->next->next; 
        
    }
    else l = l->next;
    }
    return t;
}
void sort(Node *t)
{
    Node *i = t;
    Node *j= t;
    int temp;
    for( i = t ; i!=NULL; i= i->next)
    {
        for(j= i->next ; j!=NULL ;j= j->next)
        {
            if( i->data > j->data)
            {
               
                temp = i->data;
                i->data = j->data;
                j->data = temp;
            }
        }
    }
}

Node* duprem(Node* n)
{
    if(!n || !(n->next))return n;
    Node* dummy=makeNode(-1),*dummyp=dummy;
    while(n->next)
    {
        if(n->data == n->next->data)
        {
            n=n->next;
        }
        else
        {
            dummyp->next=n;
            dummyp=dummyp->next;
            n=n->next;
        }
    }
    return dummy->next;
}

Node* AllDupRem(Node* n)
{
    if (!n || !n->next)
        return n;

    Node* dummy = makeNode(-1);
    Node* dummyp = dummy;

    while (n != NULL)
    {
        int f = 0;

        while (n->next != NULL && n->data == n->next->data)
        {
            n = n->next;
            f = 1;
        }

        if (f == 0)
        {
            dummyp->next = n;
            dummyp = dummyp->next;
            n = n->next;
        }
        else
        {
            n = n->next;
        }
    }

    dummyp->next = NULL;

    return dummy->next;
}

